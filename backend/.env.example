# ===== SmartDine Backend Environment Variables =====
# Copy this file to .env and fill in your real values:
#   cp .env.example .env

# Flask Configuration
FLASK_DEBUG=True
FLASK_PORT=5000
SECRET_KEY=change-me-to-a-random-secret-key

# Database Configuration (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=your_db_password_here
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_restaurant_ai

# Full Database URL (constructed from above values)
DATABASE_URL=postgresql://postgres:your_db_password_here@localhost:5432/smart_restaurant_ai

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Email Configuration (Gmail SMTP)
# To get an App Password: Google Account > Security > 2-Step Verification > App Passwords
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
